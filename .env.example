# Branding
RACOM_ENV_NAME="RACOM Claude Sandbox"
RACOM_IMAGE="localhost/racom/claude-sandbox:latest"
RACOM_CONTAINER_NAME="racom-claude-sandbox"
RACOM_HOSTNAME="racom-sandbox"

# --- User namespace mapping --------------------------------------------------
# ROOTLESS PODMAN: keep-id maps your host user onto the container's vscode user
# (uid 1000) so the bind-mounted ./.claude-home stays writable from both sides.
# Without it, logins and transcripts fail with EACCES.
#
# DOCKER: leave this EMPTY (RACOM_USERNS=""). Docker has no keep-id mode.
RACOM_USERNS="keep-id:uid=1000,gid=1000"

# SELinux relabelling opt-out for the bind mounts (podman on SELinux hosts).
# Docker users can leave the default.
RACOM_SECURITY_OPT="label=disable"
