# =============================================================================
#  RACOM - RipEx2 / RA2 device connection for the `ra2` (skills/api) and
#  `netconf` (skills/netconf) CLIs
# -----------------------------------------------------------------------------
#  Copy to .env.ra2 in the repo root (git-ignored) or export the same names.
#  Resolution order: CLI flags > RA2_* environment > this file.
#  Check the result with:  skills/api/scripts/ra2 env  /  skills/netconf/scripts/netconf env
# =============================================================================

# Device address (IP or hostname). Factory default of a RipEx2 is 192.168.169.169.
RA2_HOST=192.168.169.169

# Optional: HTTPS port of the device API (`ra2` / skills/api only). Change it when the device's web
# server listens elsewhere or the device sits behind a port forward. With RA2_INTERMEDIATE the port
# applies to the intermediate (that is the device spoken to over HTTPS).
#RA2_API_PORT=443

# Credentials for private methods (role Guest/Tech/Admin as required by the method).
RA2_USER=admin
RA2_PASSWORD=Admin123!

# Optional: reuse an existing session token instead of logging in.
#RA2_TOKEN=

# Optional: reach RA2_HOST through a directly reachable device over the radio link
# (Remote Access must be enabled on the target). Credentials are checked on the intermediate.
#RA2_INTERMEDIATE=

# Optional: socket timeout (s) and retries. CLI defaults 15 / 1; use more for remote targets.
#RA2_TIMEOUT=15
#RA2_RETRIES=1

# Optional: alternative API docs mirror for `ra2 doc`.
#RA2_DOCS_URL=https://ripex2-apidocs.racom.eu

# --- NETCONF (skills/netconf) -----------------------------------------------
# SSH port of the NETCONF subsystem.
#RA2_NETCONF_PORT=830
# Verify the SSH host key against ~/.ssh/known_hosts (devices have per-unit keys, so default 0).
#RA2_NETCONF_HOSTKEY_VERIFY=0
